# ── 庖丁解牛内容后台（单容器：Node 控制面/UI/发布 + 内嵌 Python 引擎 worker）──
PORT=8080
HOST=0.0.0.0
INGEST_API_TOKEN=replace-with-long-random-token
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-long-random-password
CLOUDBASE_ENV=foodie-vault-cloud-d7c230e4c1807

# 单容器进程守护：Node 主进程内嵌并守护 Python worker + 发现调度。容器默认 true。
EMBED_WORKER=true

# 本地测试：设为 true 用文件版假云（data/local-cloud-db.json + 本地媒体服务 /__localmedia），
# 无需连微信云、无需装 wx-server-sdk。生产（云托管）不要设置此项。
USE_LOCAL_CLOUD=false

# 处理包与引擎工作目录（同容器本地路径；云托管挂一个文件存储给自己即可，无需跨服务共享）。
INGEST_ROOT=/data/recipe-ingest/outgoing
PAODING_EXPORT_ROOT=/data/recipe-ingest/outgoing
PAODING_DATA_DIR=/data/paoding-work
WATCH_INGEST_ROOT=true
WATCH_INTERVAL_MS=15000

# ── 内嵌 worker ──
PAODING_API_BASE=http://127.0.0.1:8080
PAODING_WORKER_ID=paoding-worker-1
PAODING_POLL_SECONDS=20
WHISPER_MODEL=base
# 仅本地迁移期：指向原庖丁解牛项目根目录以复用未打包的 src；生产留空，用内置 engine。
PAODING_LEGACY_ROOT=

# ── 发现调度 ──
# 定时发现：>=60000 才开（毫秒）；手动发现从 Dashboard「发现」页触发。
DISCOVERY_INTERVAL_MS=0
DISCOVERY_SOURCE=food_3day
DISCOVERY_LIMIT=30

# ── LLM provider（video→结构化菜谱）──
# 云端国产模型走 OpenAI 兼容接口：
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-model-key
LLM_MAX_TOKENS=4096
# 本地想用 Claude 时：LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY(+可选 ANTHROPIC_BASE_URL)
