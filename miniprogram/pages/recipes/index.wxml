<navigation-bar title="菜谱" back="{{false}}" color="#3D2E1F" background="#F8F1E4"></navigation-bar>

<view class="recipe-page">
  <scroll-view class="recipe-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="recipe-search"><view class="recipe-search-icon"></view><input value="{{searchKeyword}}" focus="{{searchInputFocus}}" bindinput="onSearchInput" bindconfirm="directSearch" placeholder="搜索菜名、食材、菜系" placeholder-class="recipe-search-placeholder" confirm-type="search" /></view>
    <view wx:if="{{viewMode !== 'home'}}" class="recipe-subpage-back" bindtap="goToHome" hover-class="recipe-subpage-back--pressed" aria-role="button" aria-label="返回菜谱首页"><text class="recipe-subpage-back-arrow">‹</text><text>返回菜谱首页</text></view>

    <block wx:if="{{viewMode === 'home'}}">
      <view class="recipe-home">
        <view class="recipe-entry-stack"><view class="recipe-entry recipe-entry--fridge" bindtap="goToPicker" hover-class="recipe-entry--pressed" aria-role="button" aria-label="从冰箱选食材"><image class="recipe-entry-fridge-image" src="../../resource/generated/recipe-hero-fridge.png" mode="aspectFill"></image><view class="recipe-entry-wash"></view><view class="recipe-entry-copy"><text class="recipe-entry-kicker">先看看家里有什么</text><text class="recipe-entry-title">从冰箱选食材</text><text class="recipe-entry-note">优先消耗临期食材，我来配一桌菜</text><text class="recipe-entry-action">去选食材 →</text></view></view><view class="recipe-entry recipe-entry--search" bindtap="startDirectSearch" hover-class="recipe-entry--pressed" aria-role="button" aria-label="按菜名或食材找菜"><image class="recipe-entry-dish-image" src="../../resource/recipe-icon/红烧排骨.png" mode="aspectFit"></image><view class="recipe-entry-copy"><text class="recipe-entry-kicker">已有明确想法？</text><text class="recipe-entry-title">按菜名或食材找菜</text><text class="recipe-entry-note">只搜索食光已整理的菜谱库</text><text class="recipe-entry-action">开始搜索 →</text></view></view></view>
        <view class="home-section-heading"><view><text class="home-section-kicker">热门菜 · 直接开做</text><text class="home-section-title">大家都在做</text></view><text class="home-section-note">已收录菜谱</text></view>
        <scroll-view class="home-hot-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}"><view class="home-hot-list"><view wx:for="{{hotRecipes}}" wx:key="recipe.id" class="home-hot-card" bindtap="goRecipeDetail" data-id="{{item.recipe.id}}" hover-class="home-hot-card--pressed"><view class="home-hot-plate"><image wx:if="{{item.dishVisualType === 'image'}}" class="home-hot-image" src="{{item.dishVisualValue}}" mode="aspectFit"></image><text wx:else>{{item.dishVisualValue}}</text></view><text class="home-hot-name">{{item.recipe.name}}</text><text class="home-hot-rate">可做度 {{item.matchPercent}}%</text></view></view></scroll-view>
        <view class="signature-section"><view class="signature-copy"><text class="signature-kicker">我的制作记录</text><text class="signature-title">我的拿手菜</text><text class="signature-note">制作次数、照片和心得会自动整理在这里。</text></view><view class="signature-stamp" bindtap="goSignatureDishes">查看全部</view><view class="signature-list" wx:if="{{signatureDishViews.length}}"><view wx:for="{{signatureDishViews}}" wx:key="id" class="signature-item" bindtap="goSignatureDetail" data-id="{{item.id}}" hover-class="signature-item--pressed"><image class="signature-image" src="{{item.imageUrl}}" mode="aspectFill"></image><view><text class="signature-name">{{item.name}}</text><text class="signature-progress">{{item.stage}} · {{item.progress}}</text></view><text class="signature-arrow">›</text></view></view><view wx:else class="signature-empty" bindtap="goSignatureDishes"><text>还没有制作记录</text><text>完成一道菜并保存结果后，会显示在这里 →</text></view></view>
      </view>
    </block>

    <block wx:elif="{{viewMode === 'picker'}}">
      <view class="picker-hero">
        <image src="../../resource/generated/recipe-picker-fridge.png" class="picker-hero-image" mode="aspectFill"></image>
        <view class="picker-hero-wash"></view>
        <view class="picker-copy"><text class="picker-title">从冰箱里选食材</text><text class="picker-subtitle">看看能做什么吧～</text></view>
      </view>

      <view class="picker-paper">
        <view class="picker-tabs"><text class="picker-tab {{pickerCategory === 'all' ? 'picker-tab--active' : ''}}" bindtap="onPickerCategory" data-category="all">全部</text><text class="picker-tab {{pickerCategory === 'chilled' ? 'picker-tab--active' : ''}}" bindtap="onPickerCategory" data-category="chilled">冰箱</text><text class="picker-tab {{pickerCategory === 'frozen' ? 'picker-tab--active' : ''}}" bindtap="onPickerCategory" data-category="frozen">冷冻</text><text class="picker-tab {{pickerCategory === 'room' ? 'picker-tab--active' : ''}}" bindtap="onPickerCategory" data-category="room">常温</text></view>
        <view class="picker-priority-row"><view class="picker-priority-copy"><text class="picker-priority-title">优先临期</text><text class="picker-priority-note">{{expiringIngredients.length ? expiringIngredients.length + ' 样食材将在 3 天内到期' : '暂无 3 天内到期食材'}}</text></view><view wx:if="{{expiringIngredients.length}}" class="picker-priority-button" bindtap="preferExpiring" hover-class="picker-priority-button--pressed" aria-role="button" aria-label="优先选择临期食材">优先选择</view></view>
        <view class="picker-grid"><view wx:for="{{visiblePickerChoices}}" wx:key="name" class="ingredient-sticker {{item.selected ? 'ingredient-sticker--selected' : ''}}" bindtap="toggleIngredient" data-name="{{item.name}}"><image wx:if="{{item.visualType === 'image'}}" class="ingredient-sticker-image" src="{{item.visualValue}}" mode="aspectFit"></image><text wx:else class="ingredient-sticker-art">{{item.visualValue}}</text><text class="ingredient-sticker-name">{{item.name}}</text><view wx:if="{{item.selected}}" class="ingredient-sticker-check">✓</view></view></view>
        <view class="picker-bottom"><text>已选 {{selectedIngredients.length}} 种食材</text><view class="find-recipe-button" bindtap="findRecipes" hover-class="find-recipe-button--pressed" aria-role="button" aria-label="查看可做菜谱">查看菜谱</view></view>
      </view>
    </block>

    <block wx:else>
      <view class="recommend-heading"><view><text class="recommend-kicker">食光菜谱库 · 为你配好一桌</text><text class="recommend-title">为你推荐 {{recommendations.length}} 道菜</text><text wx:if="{{recommendations.length < 5}}" class="recommend-shortage">当前食材可匹配 {{recommendations.length}} 道，换食材可获得更多选择</text></view><view class="change-table-button {{isChangingTable ? 'change-table-button--busy' : ''}}" bindtap="changeTable" hover-class="change-table-button--pressed" hover-start-time="0" hover-stay-time="180" aria-role="button" aria-label="换一桌菜谱"><text>换一桌</text><text class="change-table-icon {{isChangingTable ? 'change-table-icon--spinning' : ''}}">↻</text></view></view>
      <view wx:if="{{heroRecipe}}" class="dish-hero-card {{isChangingTable ? 'dish-card--flip' : ''}}" bindtap="goRecipeDetail" data-id="{{heroRecipe.recipe.id}}" hover-class="dish-card--pressed"><view class="dish-hero-art"><view class="dish-hero-plate"><image wx:if="{{heroRecipe.dishVisualType === 'image'}}" class="dish-hero-image" src="{{heroRecipe.dishVisualValue}}" mode="aspectFit"></image><text wx:else class="dish-fallback-art">{{heroRecipe.dishVisualValue}}</text></view></view><view class="dish-card-copy"><text class="dish-card-eyebrow">今日优选</text><text class="dish-card-name">{{heroRecipe.recipe.name}}</text><text class="dish-match"><text>{{heroRecipe.matchPercent}}%</text> 可做度</text><text class="dish-card-note">{{heroRecipe.matchText}} · {{heroRecipe.missingText}}</text><view class="dish-card-footer"><text class="dish-card-meta">{{heroRecipe.recipe.duration}} 分钟 · {{heroRecipe.recipe.difficulty === 'easy' ? '简单' : '中等'}} · {{heroRecipe.recipe.servings}}人</text><text class="dish-collection">收录 4 种做法</text></view></view></view>
      <view class="dish-grid"><view wx:for="{{tableRecipes}}" wx:key="recipe.id" class="dish-mini-card {{isChangingTable ? 'dish-card--flip' : ''}}" bindtap="goRecipeDetail" data-id="{{item.recipe.id}}" hover-class="dish-card--pressed"><view class="dish-mini-art"><view class="dish-mini-plate"><image wx:if="{{item.dishVisualType === 'image'}}" class="dish-mini-image" src="{{item.dishVisualValue}}" mode="aspectFit"></image><text wx:else class="dish-mini-fallback">{{item.dishVisualValue}}</text></view></view><text class="dish-mini-name">{{item.recipe.name}}</text><text class="dish-mini-match">{{item.matchPercent}}% 可做度</text><text class="dish-mini-note">{{item.missingText}}</text><text class="dish-mini-meta">{{item.recipe.duration}}分钟 · {{item.recipe.servings}}人 · 4种做法</text></view></view>
      <view class="recommend-empty" wx:if="{{!recommendations.length && !isLoading}}"><text>这组食材能匹配的做法不多</text><view bindtap="backToPicker">回到食材选择</view></view>
      <view class="back-picker" bindtap="backToPicker" hover-class="tap-fade">← 重新选择食材</view>
    </block>
    <view class="recipe-safe-space"></view>
  </scroll-view>
</view>

<tab-bar active="recipes"></tab-bar>
