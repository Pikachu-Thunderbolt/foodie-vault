<navigation-bar title="我的" back="{{false}}" color="#3D2E1F" background="#F7F2E9"></navigation-bar>

<view class="page">
  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 参考图顶部：厨房墙、置物架与便签 -->
    <view class="kitchen-wall" aria-role="img" aria-label="挂着便签和厨具的手绘厨房墙">
      <view class="wall-bricks"></view>
      <view class="wall-picture picture-left"><view class="picture-bowl"></view></view>
      <view class="wall-picture picture-right"><view class="picture-plant"></view></view>
      <view class="memo memo-green"><text>记得</text><text>买牛奶</text><view class="memo-pin"></view></view>
      <view class="memo memo-coral"><text>周末</text><text>做蛋糕</text><view class="memo-pin"></view></view>
      <view class="memo memo-honey"><text>今晚</text><text>好好吃饭</text><view class="memo-pin"></view></view>

      <view class="wall-shelf top-shelf">
        <view class="wall-jar jar-one"><view></view></view>
        <view class="wall-jar jar-two"><view></view></view>
        <view class="wall-bottle"><view></view></view>
        <view class="wall-tin"></view>
      </view>

      <view class="rail">
        <view class="rail-hook hook-one"></view>
        <view class="rail-hook hook-two"></view>
        <view class="rail-hook hook-three"></view>
        <view class="hanging-pan"><view></view></view>
        <view class="hanging-spoon"></view>
        <view class="hanging-spatula"><view></view></view>
      </view>

      <view class="counter-shelf">
        <view class="counter-kettle"><view class="kettle-lid"></view><view class="kettle-spout"></view><view class="kettle-handle"></view></view>
        <view class="counter-cup"></view>
        <view class="counter-plant"><view class="counter-leaf leaf-left"></view><view class="counter-leaf leaf-mid"></view><view class="counter-leaf leaf-right"></view><view class="counter-pot"></view></view>
      </view>
    </view>

    <view class="profile-summary" bindtap="onAvatarTap" hover-class="profile-summary--pressed">
      <view class="avatar-frame" aria-label="用户头像">
        <image class="avatar-image" wx:if="{{cloudAvatarUrl}}" src="{{cloudAvatarUrl}}" mode="aspectFill"></image>
        <image wx:else class="avatar-image avatar-image--default" src="/resource/generated/login/default-kitchen-owner-avatar.webp" mode="aspectFit"></image>
      </view>
      <view class="profile-copy">
        <view class="nickname-row">
          <text class="nickname">{{nickName}}</text>
          <text wx:if="{{!isLoggedIn}}" class="login-tag">未登录</text>
          <text wx:else class="openid-tag">id · {{openid}}</text>
        </view>
        <view class="profile-stats">
          <text>记录 {{recordCount}}</text>
          <view class="stat-separator"></view>
          <text>收藏 {{favoriteCount}}</text>
          <view class="stat-separator"></view>
          <text>食材 {{stats.total}}</text>
        </view>
      </view>
    </view>

    <view class="signature-entry" bindtap="goSignatureDishes" hover-class="signature-entry--pressed" aria-role="button" aria-label="进入我的拿手菜">
      <view class="signature-entry-stamp">拿手菜</view><view class="signature-entry-copy"><text>我的拿手菜</text><text>查看常做的菜和每次制作记录</text><view><text>拿手菜 {{signatureCount}}</text><text>练习中 {{practicingCount}}</text><text wx:if="{{candidateCount}}">待确认 {{candidateCount}}</text></view></view><view class="menu-chevron"></view>
    </view>

    <!-- 与参考稿一致的四个主入口 -->
    <view class="primary-menu">
      <view class="menu-row" bindtap="viewIngredientList" hover-class="row-pressed" aria-role="button" aria-label="我的清单">
        <view class="line-icon icon-list"><view></view><view></view><view></view></view>
        <text class="menu-label">我的清单</text>
        <text class="menu-value">{{stats.total}} 件</text>
        <view class="menu-chevron"></view>
      </view>

      <view class="menu-row" bindtap="viewExpiryReminders" hover-class="row-pressed" aria-role="button" aria-label="临期提醒">
        <view class="line-icon icon-reminder"><view></view></view>
        <text class="menu-label">临期提醒</text>
        <view class="reminder-count" wx:if="{{stats.expiring > 0}}">{{stats.expiring}}</view>
        <view class="menu-chevron"></view>
      </view>

      <view class="menu-row" bindtap="togglePreferences" hover-class="row-pressed" aria-role="button" aria-label="设置">
        <view class="line-icon icon-settings"><view></view><text></text></view>
        <text class="menu-label">设置</text>
        <view class="menu-chevron {{showPreferences ? 'is-open' : ''}}"></view>
      </view>

      <view class="preferences-panel" wx:if="{{showPreferences}}">
        <view class="panel-heading">
          <text class="panel-title">饮食偏好</text>
          <text class="panel-note">让推荐更懂你的口味</text>
        </view>

        <view class="pref-item">
          <text class="pref-label">主题风格（影响首页场景）</text>
          <view class="pref-chips">
            <text class="pref-chip {{preferences.gender === 'male' ? 'active' : ''}}" bindtap="onGenderSelect" data-gender="male">男生</text>
            <text class="pref-chip {{preferences.gender === 'female' ? 'active' : ''}}" bindtap="onGenderSelect" data-gender="female">女生</text>
            <text class="pref-chip {{preferences.gender === 'couple' ? 'active' : ''}}" bindtap="onGenderSelect" data-gender="couple">情侣</text>
            <text class="pref-chip {{preferences.gender === 'family' ? 'active' : ''}}" bindtap="onGenderSelect" data-gender="family">一家人</text>
          </view>
        </view>

        <view class="pref-item">
          <text class="pref-label">饮食禁忌</text>
          <view class="pref-chips">
            <text wx:for="{{dietaryOptions}}" wx:key="*this" class="pref-chip {{preferences.dietaryRestrictions.indexOf(item) >= 0 ? 'active' : ''}}" bindtap="onDietaryToggle" data-item="{{item}}">{{item}}</text>
          </view>
        </view>

        <view class="pref-item pref-inline">
          <text class="pref-label">口味偏好</text>
          <picker class="pref-control" mode="selector" range="{{tastePickerOptions}}" value="{{tastePickerIndex}}" bindchange="onTasteChange">
            <view class="pref-picker">{{tastePickerOptions[tastePickerIndex]}}<view class="picker-chevron"></view></view>
          </picker>
        </view>

        <view class="pref-item pref-inline">
          <text class="pref-label">难度接受度</text>
          <picker class="pref-control" mode="selector" range="{{difficultyPickerOptions}}" value="{{difficultyPickerIndex}}" bindchange="onDifficultyChange">
            <view class="pref-picker">{{difficultyPickerOptions[difficultyPickerIndex]}}<view class="picker-chevron"></view></view>
          </picker>
        </view>

        <view class="pref-item pref-inline">
          <text class="pref-label">提前提醒</text>
          <view class="reminder-input-wrap">
            <input class="pref-input" type="number" value="{{preferences.reminderDays}}" bindinput="onReminderDaysInput" aria-label="提前提醒天数" />
            <text class="pref-unit">天</text>
          </view>
        </view>

        <view class="pref-save" bindtap="savePreferences" hover-class="button-pressed" aria-role="button">保存偏好</view>

        <view class="data-divider"></view>
        <view class="data-row" bindtap="toggleExportMenu" hover-class="row-pressed" aria-role="button" aria-label="数据管理">
          <view class="data-icon"><view></view></view>
          <text>数据管理</text>
          <view class="menu-chevron {{showExportMenu ? 'is-open' : ''}}"></view>
        </view>
        <view class="data-actions" wx:if="{{showExportMenu}}">
          <view class="data-action" bindtap="exportData" hover-class="row-pressed"><view class="copy-icon"><view></view></view><text>复制食材数据</text></view>
          <view class="data-action danger" bindtap="clearAllData" hover-class="row-pressed"><view class="delete-icon"><view></view></view><text>清除所有数据</text></view>
        </view>
      </view>

      <view class="menu-row menu-row-last" bindtap="showAbout" hover-class="row-pressed" aria-role="button" aria-label="关于我们">
        <view class="line-icon icon-about"><view></view><text></text></view>
        <text class="menu-label">关于我们</text>
        <view class="menu-chevron"></view>
      </view>
    </view>

    <view class="logout-row" wx:if="{{isLoggedIn}}" bindtap="onLogout" hover-class="logout-row--pressed" aria-role="button" aria-label="退出登录">
      <text>退出登录</text>
    </view>
    <view class="logout-row" wx:else bindtap="onAvatarTap" hover-class="logout-row--pressed" aria-role="button" aria-label="登录">
      <text>登录 / 授权</text>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>
</view>

<tab-bar active="profile"></tab-bar>
