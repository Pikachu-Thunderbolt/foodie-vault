<navigation-bar title="我的拿手菜" color="#3D2E1F" background="#F7F2E9"></navigation-bar>
<view class="page paper-bg">
  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero"><view class="hero-tape"></view><text class="hero-kicker">制作记录</text><text class="hero-title">常做的菜，都整理在这里。</text><view class="hero-stats"><view><text>{{signatures.length}}</text><text>拿手菜</text></view><view><text>{{practicing.length}}</text><text>练习中</text></view><view><text>{{totalCooks}}</text><text>制作次数</text></view></view></view>
    <scroll-view class="group-scroll" scroll-x show-scrollbar="{{false}}"><view class="groups"><text class="group {{activeGroup === 'all' ? 'group--active' : ''}}" bindtap="switchGroup" data-group="all">全部</text><text class="group {{activeGroup === 'signature' ? 'group--active' : ''}}" bindtap="switchGroup" data-group="signature">拿手菜</text><text class="group {{activeGroup === 'practicing' ? 'group--active' : ''}}" bindtap="switchGroup" data-group="practicing">练习中</text><text class="group {{activeGroup === 'candidate' ? 'group--active' : ''}}" bindtap="switchGroup" data-group="candidate">待确认 {{candidates.length}}</text></view></scroll-view>
    <view class="dish-grid" wx:if="{{visible.length}}"><view wx:for="{{visible}}" wx:key="id" class="dish-card {{item.candidate ? 'dish-card--candidate' : ''}}" bindtap="goDetail" data-id="{{item.id}}" hover-class="dish-card--pressed"><view class="photo-frame"><image src="{{item.imageUrl}}" mode="aspectFill"></image><text class="growth-badge">{{item.growthLabel}}</text></view><text class="dish-name">{{item.personalName}}</text><text class="canonical" wx:if="{{item.personalName !== item.canonicalName}}">原菜名：{{item.canonicalName}}</text><text class="dish-meta">做过 {{item.cookCount}} 次 · 最近 {{item.latestDate}}</text><text class="dish-tip" wx:if="{{item.tagline}}">“{{item.tagline}}”</text><text class="candidate-note" wx:if="{{item.candidate}}">可以设为拿手菜，点击确认 →</text></view></view>
    <view class="empty" wx:else><view class="empty-wall"><view></view><text></text></view><text class="empty-title">还没有制作记录</text><text class="empty-desc">完成一道菜并保存结果后，会显示在这里。</text><view class="empty-action" bindtap="goRecipes">去找菜谱</view></view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
